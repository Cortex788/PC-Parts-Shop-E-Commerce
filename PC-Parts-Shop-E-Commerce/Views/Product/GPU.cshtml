@using PC_Parts_Shop_E_Commerce.ModelsViews;
@model IEnumerable<GpuCardViewModel>

<div class="container my-4">
    <div class="row g-4">

        <aside class="col-12 col-md-3 col-lg-2">
            <partial name="_ProductFilterPartial" />
        </aside>



        <section class="col-12 col-md-9 col-lg-10">

            <div class="mb-3">
                <a asp-controller="GPU"
                   asp-action="Add"
                   class="btn btn-primary btn-sm flex-fill">
                    Add
                </a>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
                @foreach (var gpu in Model)
                {
                    <div class="col">
                        <partial name="_GpuCardPartial" model="gpu" />
                    </div>
                }
            </div>
        </section>

    </div>
</div>