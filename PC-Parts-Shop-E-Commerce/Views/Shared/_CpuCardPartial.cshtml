@using PC_Parts_Shop_E_Commerce.ModelsViews;
@model CpuCardViewModel

<div class="card product-card h-100">
    @if (!string.IsNullOrEmpty(Model.ImageURL))
    {
        <div class="product-image-container">
            <img src="@Model.ImageURL"
                 class="card-img-top product-image p-3"
                 alt="@Model.Name" />
        </div>
    }

    <div class="card-body d-flex flex-column">
        <h6 class="card-title">@Model.Name</h6>
        <p class="text-muted mb-2">@Model.Brand</p>

        <ul>
            <li>
                <strong>Cores:</strong> @Model.Cores
            </li>
            <li>
                <strong>Threads:</strong> @Model.Threads
            </li>
            <li>
                <strong>Base Clock:</strong> @Model.BaseClock MHz
            </li>
            <li>
                <strong>Boost Clock:</strong> @Model.BoostClock MHz
            </li>
            <li>
                <strong>Socket:</strong> @Model.SocketType
            </li>
            <li>
                <strong>Integrated Graphics:</strong>
                @(string.IsNullOrEmpty(Model.IntegratedGraphics)
                    ? "Dedicated Graphics Required"
                    : Model.IntegratedGraphics)
            </li>
        </ul>

        <div class="mt-auto pt-3">
            <h5>@Model.Price €</h5>

            <span class="badge rounded-pill @(Model.StockQuantity > 0 ? "bg-success" : "bg-danger")">
                @(Model.StockQuantity > 0 ? "Available" : "Out of stock")
            </span>

            <div class="mt-3 d-flex gap-2">
                <a asp-controller="CPU"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-info btn-sm flex-fill">
                    Details
                </a>

                <a asp-controller="CPU"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning btn-sm flex-fill">
                    Edit
                </a>

                <a asp-controller="CPU"
                   asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-danger btn-sm flex-fill">
                    Delete
                </a>
            </div>
        </div>
    </div>
</div>