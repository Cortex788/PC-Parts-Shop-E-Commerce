@using PC_Parts_Shop_E_Commerce.ModelsViews;
@model ProductCardViewModel

<div class="card product-card">
    @if (!string.IsNullOrEmpty(Model.ImageURL))
    {
        <div class="product-image-container">
            <img src="@Model.ImageURL"
                 class="card-img-top product-image p-3"
                 alt="@Model.Name" />
        </div>
    }
    <div class="card-body d-flex flex-column">
        <h6 class="card-title">@Model.Name</h6>
        <p class="text-muted mb-2">@Model.Brand</p>

        <div class="mt-auto pt-3">
            <h5>@Model.Price €</h5>
        </div>
        <a class="btn btn-primary" href="#" role="button">More details</a>
    </div>
</div>