@using PC_Parts_Shop_E_Commerce.ModelsViews
@model RamCardViewModel




<div class="card product-card h-100">
    @if (!string.IsNullOrEmpty(Model.ImageURL))
    {
        <div class="product-image-container">
            <img src="@Model.ImageURL"
                 class="card-img-top product-image p-3"
                 alt="@Model.Name" />
        </div>
    }

    <div class="card-body d-flex flex-column">
        <h6 class="card-title">@Model.Name</h6>
        <p class="text-muted mb-2">@Model.Brand</p>

        <ul>
            <li>
                <strong>Capacity:</strong> @Model.Capacity GB
            </li>
            <li>
                <strong>Type:</strong> @Model.MemoryType
            </li>
            <li>
                <strong>Speed:</strong> @Model.MemorySpeed MHz
            </li>
        </ul>

        <div class="mt-auto pt-3">
            <h5>@Model.Price €</h5>

            <span class="badge rounded-pill @(Model.StockQuantity > 0 ? "bg-success" : "bg-danger")">
                @(Model.StockQuantity > 0 ? "Available" : "Out of stock")
            </span>

            <div class="mt-3 d-flex gap-2">

                <a asp-controller="Ram"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning btn-sm flex-fill">
                    Edit
                </a>

                <a asp-controller="Ram"
                   asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-danger btn-sm flex-fill">
                    Delete
                </a>
            </div>
        </div>
    </div>
</div>